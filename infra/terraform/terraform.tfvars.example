# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is where your real values live - keep it out of git
# (it's already covered by the .gitignore pattern below).

public_key_path  = "~/.ssh/ptroject_new.pub"
allowed_ssh_cidr = "203.0.113.5/32" # replace with YOUR IP from whatismyip.com
